{
  "name": "squid-trace-gesture-survival",
  "version": "1.0.0",
  "description": "Production-ready multi-device multiplayer web application for Squid Trace: Gesture Survival",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server\" \"npm run client\" --names \"SERVER,CLIENT\" --prefix-colors \"bgMagenta.bold,bgCyan.bold\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
